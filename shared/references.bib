@article{acevedo_mobilityhexvis_2026,
	title = {{MobilityHexVis}: Analyzing socioeconomic urban mobility patterns through small multiples visualization},
	rights = {Creative Commons Attribution-{NonCommercial}-{NoDerivatives} 4.0 International License},
	issn = {2399-8083},
	url = {https://doi.org/10.1177/23998083261437300},
	doi = {10.1177/23998083261437300},
	shorttitle = {{MobilityHexVis}},
	abstract = {Urban mobility patterns reveal important socio-spatial phenomena, yet visualizing these patterns from massive datasets presents significant challenges. We introduce {MobilityHexVis}, an interactive visualization platform for analyzing urban mobility flows from mobile phone data classified by socioeconomic status. Our approach employs small multiples visualization with hexagonal glyphs, enabling simultaneous comparison of mobility patterns across different socioeconomic groups and distance ranges. Each hexagon displays origin-destination proportions using a bi-color split representation, while a Gini index quantifies social mixture in urban areas. Through a case study in Santiago, Chile, we demonstrate how the platform reveals employment centers and socioeconomic differences in mobility patterns. A pilot study confirms the platform’s effectiveness while identifying areas for improvement. {MobilityHexVis} contributes to urban mobility understanding and provides a tool to support evidence-based planning toward more inclusive cities.},
	pages = {23998083261437300},
	journaltitle = {Environment and Planning B: Urban Analytics and City Science},
	publisher = {{SAGE} Publications Ltd {STM}},
	author = {Acevedo, Alan and Graells-Garrido, Eduardo and Samaniego, Horacio},
	urldate = {2026-03-20},
	date = {2026-03-19},
	file = {PDF:/home/horo/Zotero/storage/JQLTC5YN/Acevedo et al. - 2026 - MobilityHexVis Analyzing socioeconomic urban mobility patterns through small multiples visualizatio.pdf:application/pdf},
}

@article{desalencar_validating_2026,
	title = {Validating urban scaling laws through mobile phone data: analysis of Brazil’s largest cities},
	volume = {6},
	rights = {Creative Commons Attribution-{NonCommercial}-{ShareAlike} 4.0 International License},
	issn = {2730-6852},
	url = {https://doi.org/10.1007/s43762-026-00252-x},
	doi = {10.1007/s43762-026-00252-x},
	shorttitle = {Validating urban scaling laws through mobile phone data},
	abstract = {Urban scaling theories posit that larger cities exhibit disproportionately higher levels of socioeconomic activity and human interactions. Yet, evidence from developing countries (especially those marked by stark socioeconomic disparities) remains limited. To address this gap, we analyse a month-long dataset of 3.1 billion voice-call records from Brazil’s 100 most populous cities, providing a national-scale test of urban scaling laws. We measure interactions using two complementary proxies: the number of phone-based contacts (voice-call degrees) and the number of trips inferred from consecutive calls in distinct locations. Our findings reveal clear superlinear relationships in both metrics, indicating that larger urban centres exhibit intensified remote communication and physical mobility. We further observe that gross domestic product ({GDP}) also scales superlinearly with population, consistent with broader claims that economic output grows faster than city size. Conversely, the number of antennas required per user scales sublinearly, suggesting economies of scale in telecommunications infrastructure. Although the dataset covers a single provider, its widespread coverage in major cities supports the robustness of the results. We nonetheless discuss potential biases, including city-specific marketing campaigns and predominantly prepaid users, as well as the open question of whether higher interaction drives wealth or vice versa. Overall, this study enriches our understanding of urban scaling especially in the global south, emphasising how communication and mobility jointly shape the socioeconomic landscapes of rapidly growing cities.},
	pages = {21},
	number = {1},
	journaltitle = {Computational Urban Science},
	shortjournal = {Comput.Urban Sci.},
	author = {de S. Alencar, Ricardo and Ribeiro, Fabiano L. and Samaniego, Horacio and Menezes, Ronaldo and Evsukoff, Alexandre G.},
	urldate = {2026-03-27},
	date = {2026-03-27},
	langid = {english},
	keywords = {Social interactions, Human mobility, {CDR} data, Urban scaling},
	file = {Full Text PDF:/home/horo/Zotero/storage/JXCI73DZ/de S. Alencar et al. - 2026 - Validating urban scaling laws through mobile phone data analysis of Brazil’s largest cities.pdf:application/pdf},
}

